---
import '../styles/global.css';
import site from '../../data/site.json';
const { title, description, image, type = 'website', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE = 'https://giaccioproperties.com';
const canonicalURL = new URL((Astro.url.pathname.replace(/\/$/, '') || '/'), SITE).href;
const pageTitle = title ? `${title} — Giaccio Properties` : 'Giaccio Properties — Homes Built by Hand in Westchester County, NY';
const metaDesc = description || 'A family portfolio of homes built by hand across Westchester County, New York. Browse houses for sale and rent from Giaccio Properties, a family of licensed builders.';
const ogImage = new URL(image || '/assets/properties/ashwood-road-19-south-salem/main.jpg', SITE).href;
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: 'Giaccio Properties',
  url: SITE,
  image: ogImage,
  logo: new URL('/favicon.png', SITE).href,
  email: site.contact.email,
  areaServed: { '@type': 'AdministrativeArea', name: 'Westchester County, New York' },
  address: { '@type': 'PostalAddress', streetAddress: '143 Bedford Rd', addressLocality: 'Katonah', addressRegion: 'NY', postalCode: '10536', addressCountry: 'US' },
  knowsAbout: ['Custom home building', 'Residential real estate', 'Westchester County homes'],
};
const showPhone = site.contact.phone && !site.contact.phone.startsWith('[');
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.contact.address || '')}`;
const nav = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/#listings`, label: 'The Collection' },
  { href: `${base}/contact`, label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () { try { document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark'); } catch (e) {} })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#14140f" />
    <meta name="author" content="Giaccio Properties" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Giaccio Properties" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important;}</style></noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header" id="header">
      <div class="wrap">
        <a href={`${base}/`} class="brand">Giaccio<span class="brand-sub">Properties</span></a>
        <nav class="nav" id="nav">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="header-actions">
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle light or dark theme">&#9788;</button>
          <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav" id="navToggle">&#9776;</button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <div class="brand" style="font-family:var(--serif);font-size:1.6rem;letter-spacing:.04em;">Giaccio Properties</div>
            <p style="max-width:340px;">A family portfolio of homes built across Westchester County, New York. Sold, rented, and available, each one built by our family.</p>
          </div>
          <div>
            <h2>Explore</h2>
            {nav.map((n) => <div><a href={n.href}>{n.label}</a></div>)}
          </div>
          <div>
            <h2>Contact</h2>
            <div><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div>
            {showPhone && <div><a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a></div>}
            {site.contact.address && <div><a href={mapsUrl} target="_blank" rel="noopener">{site.contact.address}</a></div>}
            <div>{site.contact.area}</div>
          </div>
        </div>
        <div class="foot-bottom">
          <span>&copy; {new Date().getFullYear()} Giaccio Properties. All rights reserved.</span>
          <span>Licensed Builders · Westchester County, NY</span>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById('header');
      const hasHero = !!document.querySelector('.hero');
      const onScroll = () => header.classList.toggle('scrolled', !hasHero || window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const t = document.getElementById('navToggle');
      const n = document.getElementById('nav');
      t && t.addEventListener('click', () => {
        const open = n.classList.toggle('open');
        t.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      n && n.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
        n.classList.remove('open');
        t && t.setAttribute('aria-expanded', 'false');
      }));

      const root = document.documentElement;
      const tt = document.getElementById('themeToggle');
      const setIcon = () => { tt.innerHTML = root.getAttribute('data-theme') === 'light' ? '&#9790;' : '&#9788;'; };
      setIcon();
      tt && tt.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        setIcon();
      });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
