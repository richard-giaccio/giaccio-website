---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProperties, getTowns } from '../lib/properties.js';
import site from '../../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = getProperties();
const towns = getTowns();

const SITE = 'https://giaccioproperties.com';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Richard Giaccio',
  givenName: 'Richard',
  familyName: 'Giaccio',
  jobTitle: 'Licensed Home Builder',
  description: 'Richard Giaccio is a licensed home builder and the founder of Giaccio Properties. He builds custom homes by hand across Westchester County, New York.',
  url: `${SITE}/about`,
  mainEntityOfPage: `${SITE}/about`,
  worksFor: { '@type': 'Organization', name: 'Giaccio Properties', url: SITE },
  founder: { '@type': 'Organization', name: 'Giaccio Properties', url: SITE },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Builder License',
    name: 'Licensed Home Builder',
    identifier: '40GI1153960',
  },
  knowsAbout: ['Custom home building', 'Residential construction', 'Home builder in Westchester County, New York'],
  areaServed: { '@type': 'AdministrativeArea', name: 'Westchester County, New York' },
};
---
<BaseLayout
  title="Richard Giaccio, Licensed Home Builder in Westchester County, NY"
  description="Richard Giaccio is a licensed home builder (License #40GI1153960) and founder of Giaccio Properties. He builds custom homes by hand across Westchester County, New York, alongside John Giaccio."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Our Story</p>
      <h1>{site.about.title}</h1>
      {site.about.body.map((para, i) => (
        <p style={i === 0 ? 'font-size:1.15rem;' : ''}>{para}</p>
      ))}

      <h2 style="margin-top:44px;">Richard Giaccio, Licensed Home Builder</h2>
      {site.about.founder_note && (
        <div style="border-left:3px solid var(--gold);padding:6px 0 6px 24px;margin:20px 0 34px;color:var(--ink-soft);font-style:italic;">
          {site.about.founder_note}
        </div>
      )}

      <div class="signature">{site.about.signature}</div>

      <div class="stats" style="margin-top:50px;">
        <div class="stat"><div class="num">{all.length}</div><div class="lbl">Homes Built</div></div>
        <div class="stat"><div class="num">{towns.length}</div><div class="lbl">Communities</div></div>
        <div class="stat"><div class="num">1</div><div class="lbl">Family</div></div>
      </div>

      <div style="margin-top:44px;"><a href={`${base}/contact`} class="btn">Get in Touch</a></div>
    </div>
  </section>
</BaseLayout>
