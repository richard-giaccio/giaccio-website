---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../../data/site.json';
const showPhone = site.contact.phone && !site.contact.phone.startsWith('[');
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.contact.address || '')}`;
---
<BaseLayout title="Contact" description="Contact Giaccio Properties about homes for sale or rent in Westchester County, New York. Reach the Giaccio family directly.">
  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Get in Touch</p>
        <h1>Talk to the family</h1>
        <p>{site.contact.intro}</p>
      </div>

      <div class="contact-grid">
        <form class="form" id="contactForm" novalidate>
          <div class="field-row">
            <input name="name" aria-label="Your name" placeholder="Your name" required />
            <input name="email" type="email" inputmode="email" autocomplete="email" aria-label="Email address" placeholder="Email address" required />
          </div>
          <div class="field-row">
            <input name="phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="14" pattern="[0-9()\-.\s]*" aria-label="Phone number (optional)" placeholder="Phone number (optional)" />
            <input name="property" id="propertyField" aria-label="Home you're interested in (optional)" placeholder="Home you're interested in (optional)" />
          </div>
          <textarea name="message" aria-label="Your message" placeholder="Tell us what you're looking for, or ask about any home..." required></textarea>
          <button class="btn" type="submit">Send Message</button>
          <p id="formStatus" role="status" aria-live="polite" style="margin-top:14px;display:none;"></p>
        </form>

        <div>
          <h2>Reach us directly</h2>
          <p style="margin-top:14px;">Email<br /><a href={`mailto:${site.contact.email}`} style="color:var(--gold-soft);font-weight:600;">{site.contact.email}</a></p>
          {showPhone && <p>Phone<br /><a href={`tel:${site.contact.phone}`} style="color:var(--gold-soft);font-weight:600;">{site.contact.phone}</a></p>}
          {site.contact.address && <p>Visit<br /><a href={mapsUrl} target="_blank" rel="noopener" style="color:var(--gold-soft);font-weight:600;">{site.contact.address}</a></p>}
          <p>Area Served<br />{site.contact.area}</p>
          <p style="margin-top:20px;color:var(--muted);font-size:.92rem;">Every message is read personally by our family. We'll get back to you soon.</p>
        </div>
      </div>
    </div>
  </section>

  {site.contact.address && (
    <section class="section">
      <div class="wrap">
        <div class="map-head">
          <p class="eyebrow">Find Us</p>
          <a class="map-address" href={mapsUrl} target="_blank" rel="noopener" style="display:inline-block;">{site.contact.address}</a>
        </div>
        <div class="map-wrap">
          <iframe
            title="Giaccio Properties location map"
            src={`https://www.google.com/maps?q=${encodeURIComponent(site.contact.address)}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  )}
  <script>
    // Prefill "property" from ?property= on the URL
    const params = new URLSearchParams(location.search);
    const prop = params.get('property');
    if (prop) { const f = document.getElementById('propertyField'); if (f) f.value = prop; }

    // Submit the contact form to Google Forms in the background (no redirect).
    const GFORM = 'https://docs.google.com/forms/d/e/1FAIpQLSf6SyUkkeHnph1y0Zw5IqqSX3jt2PV-eb6lO7uNuuULSqLWJg/formResponse';
    const ENTRY = {
      name: 'entry.1933543268',
      email: 'entry.1410632378',
      phone: 'entry.1694255272',
      property: 'entry.1000711556',
      message: 'entry.1322574206',
    };
    const form = document.getElementById('contactForm');
    const status = document.getElementById('formStatus');
    const btn = form && form.querySelector('button[type="submit"]');

    function showStatus(msg, ok) {
      if (!status) return;
      status.textContent = msg;
      status.style.display = 'block';
      status.style.color = ok ? 'var(--gold-soft)' : 'var(--error)';
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form).entries());
        const email = (data.email || '').trim();
        const phone = (data.phone || '').trim();
        if (!data.name || !email || !data.message) {
          showStatus('Please fill in your name, email, and message.', false);
          return;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showStatus('Please enter a valid email address.', false);
          return;
        }
        if (phone && phone.replace(/\D/g, '').length !== 10) {
          showStatus('Phone number should be 10 digits.', false);
          return;
        }
        const body = new URLSearchParams();
        for (const [key, entry] of Object.entries(ENTRY)) {
          if (data[key]) body.append(entry, data[key]);
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }
        try {
          // no-cors: Google Forms accepts the POST but returns an opaque response.
          await fetch(GFORM, { method: 'POST', mode: 'no-cors', body });
          form.reset();
          showStatus("Thank you. Your message has been sent, we'll be in touch soon.", true);
        } catch (err) {
          showStatus('Something went wrong sending your message. Please email us directly.', false);
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = 'Send Message'; }
        }
      });
    }
  </script>
</BaseLayout>
