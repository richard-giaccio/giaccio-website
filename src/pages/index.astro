---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getProperties, getTownGroups } from '../lib/properties.js';
import site from '../../data/site.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const portfolio = site.portfolio;
const all = getProperties();
const towns = getTownGroups();
const photographed = all.filter((p) => p.hasPhotos);

// one house per town first, so the portfolio shows range instead of eight
// addresses from whichever town happens to sort first
const seen = new Set();
const featured = [];
for (const p of photographed) {
  if (!p.town || seen.has(p.town)) continue;
  seen.add(p.town);
  featured.push(p);
  if (featured.length === 8) break;
}
for (const p of photographed) {
  if (featured.length === 8) break;
  if (!featured.includes(p)) featured.push(p);
}

// the hero is a ninth house so the same image never appears twice on one screen
const heroPick = photographed.find((p) => !featured.includes(p)) || featured[0];
const hero = heroPick?.featured || null;

const description = `${portfolio.title} is a builder in Westchester County, New York and the founder of Giaccio Properties. Two generations of homes: ${all.length} addresses across ${towns.length} towns.`;
---
<BaseLayout description={description}>
  <section class="hero">
    {hero && (
      <picture>
        <source srcset={hero.webp} type="image/webp" />
        <img class="hero-bg" src={hero.jpg} alt="" fetchpriority="high" decoding="async" />
      </picture>
    )}
    <div class="wrap">
      <p class="eyebrow" style="color:var(--gold-soft)">{portfolio.eyebrow}</p>
      <h1>{portfolio.title}</h1>
      <p class="founder-line" style="color:var(--gold-soft)">{portfolio.role}</p>
      <div class="gold-rule center"></div>
      <p class="sub">{portfolio.intro}</p>
      <a href="#work" class="btn">{portfolio.cta}</a>
      <a href={`${base}/about`} class="btn" style="margin-left:10px;">About</a>
    </div>
    <div class="scroll-cue">Scroll</div>
  </section>

  <section class="section alt" id="work">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{portfolio.work.eyebrow}</p>
        <h2>{portfolio.work.title}</h2>
        <div class="gold-rule center"></div>
        <p>{portfolio.work.intro}</p>
      </div>

      <div class="work-grid">
        {featured.map((p, i) => (
          <div data-reveal data-delay={String(i % 3)}><WorkCard p={p} /></div>
        ))}
      </div>

      <p style="text-align:center;margin-top:60px;" data-reveal>
        <a href={`${base}/collection`} class="btn">{portfolio.work.cta}</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{portfolio.craft.eyebrow}</p>
        <h2>{portfolio.craft.title}</h2>
        <div class="gold-rule center"></div>
        <p>{portfolio.craft.intro}</p>
      </div>

      <div class="craft">
        {portfolio.craft.items.map((item, i) => (
          <div class="craft-item" data-reveal>
            <span class="craft-num">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>

      <div class="stats" style="margin-top:80px;">
        <div class="stat"><div class="num">{all.length}</div><div class="lbl">Homes in the Collection</div></div>
        <div class="stat"><div class="num">{towns.length}</div><div class="lbl">Towns</div></div>
        <div class="stat"><div class="num">2</div><div class="lbl">Generations</div></div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap" data-reveal>
      <p class="eyebrow" style="color:var(--gold-soft)">{site.visit.eyebrow}</p>
      <h2>{site.visit.title}</h2>
      <div class="gold-rule center"></div>
      <p>{site.visit.body}</p>
      <a href={`${base}/contact`} class="btn">{site.visit.cta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 26px;
  }
  :global(.work) {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--bg-3); border: 1px solid var(--line); border-radius: 14px;
    transition: .35s;
  }
  :global(.work:hover) { border-color: var(--gold-line); box-shadow: var(--shadow); transform: translateY(-4px); }
  :global(.work-media) { position: relative; aspect-ratio: 3/2; background: #000; overflow: hidden; }
  :global(.work-media img) {
    width: 100%; height: 100%; object-fit: cover;
    filter: brightness(.92); transition: .6s cubic-bezier(.2,.7,.2,1);
  }
  :global(.work:hover .work-media img) { transform: scale(1.06); filter: brightness(1); }
  :global(.work-media .noimg) {
    display: flex; align-items: center; justify-content: center; height: 100%;
    color: var(--muted); font-family: var(--serif); font-style: italic;
  }
  :global(.work-body) { padding: 24px 24px 26px; }
  :global(.work-body h3) { font-size: 1.4rem; margin-bottom: 4px; }
  :global(.work-loc) {
    color: var(--muted); font-size: .8rem; letter-spacing: .06em;
    text-transform: uppercase; margin-bottom: 14px;
  }
  :global(.work-arrow) {
    font-size: .72rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--gold); opacity: 0; transform: translateX(-6px); transition: .3s;
  }
  :global(.work:hover .work-arrow) { opacity: 1; transform: none; }

  .craft { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 40px; }
  .craft-item { border-top: 1px solid var(--gold-line); padding-top: 22px; }
  .craft-num { font-family: var(--serif); font-size: .9rem; color: var(--gold); letter-spacing: .1em; }
  .craft-item h3 { font-size: 1.6rem; margin: 8px 0 10px; }
  .craft-item p { color: var(--body); font-size: .98rem; }

  @media (max-width: 700px) {
    .hero .btn { display: inline-block; margin: 8px 6px 0; }
  }
</style>
