---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProperties, getProperty, formatPrice, statusLabel } from '../../lib/properties.js';

export function getStaticPaths() {
  return getProperties().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = getProperty(slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const price = formatPrice(p.price);
const specs = [
  ['Bedrooms', p.bedrooms],
  ['Bathrooms', p.bathrooms],
  ['Square Feet', p.size_sqft != null ? Number(p.size_sqft).toLocaleString() : null],
  ['Year Built', p.year_built],
  ['Heating', p.heating],
  ['Parking', p.parking],
  ['Type', p.property_type],
  ['County', p.county],
].filter(([, v]) => v != null && v !== '');
const hero = p.main;
const thumbs = p.thumbs && p.thumbs.length ? p.thumbs : p.images.slice(1, 3);
const rows = Math.max(thumbs.length, 1);
const mapQuery = `${p.displayAddress}, ${p.location}`;
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;

const SITE = 'https://giaccioproperties.com';
const pageUrl = `${SITE}/properties/${p.slug}`;
const heroAbs = new URL(hero ? hero.jpg : '/assets/properties/ashwood-road-19-south-salem/main.jpg', SITE).href;
const metaDesc = `${p.displayAddress} in ${p.location}${price ? ` — ${price}` : ''}. A Giaccio Properties home, built by hand in Westchester County, New York. View photos, details, and location.`;
const propertySchema = {
  '@context': 'https://schema.org',
  '@type': 'Residence',
  name: mapQuery,
  url: pageUrl,
  image: heroAbs,
  address: { '@type': 'PostalAddress', streetAddress: p.displayAddress, addressLocality: p.town, addressRegion: p.state, addressCountry: 'US' },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'The Collection', item: `${SITE}/#listings` },
    { '@type': 'ListItem', position: 3, name: mapQuery, item: pageUrl },
  ],
};
---
<BaseLayout title={mapQuery} description={metaDesc} image={hero ? hero.jpg : undefined} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(propertySchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {p.hasPhotos ? (
    <div class={`detail-hero${thumbs.length === 0 ? ' nothumbs' : ''}`} style={`grid-template-rows: repeat(${rows}, 1fr);`}>
      <div class="main" style={`grid-row: 1 / ${rows + 1};`}><img src={hero.jpg} data-full={hero.jpg} alt={p.displayAddress} class="lb" /></div>
      {thumbs.map((t) => <div class="thumb"><img src={t.thumb} data-full={t.jpg} alt="" class="lb" /></div>)}
    </div>
  ) : (
    <div class="detail-hero"><div class="main noimg" style="display:flex;align-items:center;justify-content:center;background:var(--bg-2);color:var(--muted);font-family:var(--serif);font-style:italic;font-size:1.4rem;">Photos coming soon</div></div>
  )}

  <div class="wrap">
    <div class="detail-body">
      <div>
        <p class="eyebrow">{p.location}{p.status ? ` · ${statusLabel(p.status)}` : ''}</p>
        <h1>{p.displayAddress}</h1>
        {price ? <div class="card-price" style="font-size:2rem;">{price}</div> : <div class="card-price tbd" style="font-size:1.2rem;">Contact for pricing</div>}

        {specs.length > 0 ? (
          <div class="spec-grid">
            {specs.map(([k, v]) => <div><div class="k">{k}</div><div class="v">{v}</div></div>)}
          </div>
        ) : (
          <div class="note-banner" style="margin:30px 0;text-align:left;">Full details for this property are being finalized. Contact us for bedrooms, baths, square footage, and pricing.</div>
        )}

        {p.description && <p>{p.description}</p>}

        {p.images.length > 1 && (
          <>
            <h2 style="margin-top:40px;">Gallery</h2>
            <div class="gallery">
              {p.images.map((img) => <img src={img.thumb} data-full={img.jpg} alt={p.displayAddress} class="lb" loading="lazy" />)}
            </div>
          </>
        )}

        <h2 style="margin-top:40px;">Location</h2>
        <a class="map-address" href={mapLink} target="_blank" rel="noopener" style="display:inline-block;margin-bottom:12px;color:var(--gold-soft);font-weight:600;">{p.displayAddress}, {p.location}</a>
        <div class="map-wrap">
          <iframe
            title={`Map of ${p.displayAddress}`}
            src={mapEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <aside>
        <div class="aside-card">
          <h2>Interested?</h2>
          <p>Request a private showing or more information about {p.displayAddress}.</p>
          <a href={`${base}/contact?property=${encodeURIComponent(p.displayAddress + ', ' + p.location)}`} class="btn" style="width:100%;text-align:center;">Request Info</a>
          <p style="margin-top:20px;font-size:.9rem;">Or email us directly at<br /><a href="mailto:info@giaccioproperties.com" style="color:var(--gold-soft);font-weight:600;">info@giaccioproperties.com</a></p>
        </div>
      </aside>
    </div>
    <p style="padding-bottom:60px;"><a href={`${base}/#listings`} style="color:var(--gold-soft);font-weight:600;">&larr; Back to all listings</a></p>
  </div>

  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged property photo" aria-hidden="true" tabindex="-1">
    <button id="lbClose" class="lb-close" type="button" aria-label="Close photo">&times;</button>
    <img id="lbImg" alt="" />
  </div>
  <script>
    const lb = document.getElementById('lightbox');
    const lbImg = document.getElementById('lbImg');
    const lbClose = document.getElementById('lbClose');
    let lastTrigger = null;

    function openLb(im) {
      lastTrigger = im;
      lbImg.src = im.dataset.full;
      lbImg.alt = im.alt || 'Enlarged property photo';
      lb.classList.add('open');
      lb.setAttribute('aria-hidden', 'false');
      lb.focus();
    }
    function closeLb() {
      lb.classList.remove('open');
      lb.setAttribute('aria-hidden', 'true');
      lbImg.src = '';
      lbImg.alt = '';
      if (lastTrigger) { lastTrigger.focus(); lastTrigger = null; }
    }

    document.querySelectorAll('img.lb').forEach((im) => {
      im.setAttribute('role', 'button');
      im.setAttribute('tabindex', '0');
      if (!im.getAttribute('aria-label')) im.setAttribute('aria-label', 'View larger photo');
      im.addEventListener('click', () => openLb(im));
      im.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLb(im); }
      });
    });
    lb.addEventListener('click', (e) => { if (e.target !== lbClose) closeLb(); });
    lbClose.addEventListener('click', closeLb);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lb.classList.contains('open')) closeLb();
    });
  </script>
</BaseLayout>
