---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProperties, getProperty, formatPrice, statusLabel } from '../../lib/properties.js';

export function getStaticPaths() {
  return getProperties().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = getProperty(slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const price = formatPrice(p.price);
const specs = [
  ['Bedrooms', p.bedrooms],
  ['Bathrooms', p.bathrooms],
  ['Square Feet', p.size_sqft != null ? Number(p.size_sqft).toLocaleString() : null],
  ['Year Built', p.year_built],
  ['Heating', p.heating],
  ['Parking', p.parking],
  ['Type', p.property_type],
  ['County', p.county],
].filter(([, v]) => v != null && v !== '');
const hero = p.main;
const thumbs = p.thumbs && p.thumbs.length ? p.thumbs : p.images.slice(1, 3);
const rows = Math.max(thumbs.length, 1);
---
<BaseLayout title={p.address} description={`${p.address}, ${p.location}`}>
  {p.hasPhotos ? (
    <div class="detail-hero" style={`grid-template-rows: repeat(${rows}, 1fr);`}>
      <div class="main" style={`grid-row: 1 / ${rows + 1};`}><img src={hero.jpg} data-full={hero.jpg} alt={p.address} class="lb" /></div>
      {thumbs.map((t) => <div class="thumb"><img src={t.thumb} data-full={t.jpg} alt="" class="lb" /></div>)}
    </div>
  ) : (
    <div class="detail-hero"><div class="main noimg" style="display:flex;align-items:center;justify-content:center;background:var(--bg-2);color:var(--muted);font-family:var(--serif);font-style:italic;font-size:1.4rem;">Photos coming soon</div></div>
  )}

  <div class="wrap">
    <div class="detail-body">
      <div>
        <p class="eyebrow">{p.location}{p.status ? ` · ${statusLabel(p.status)}` : ''}</p>
        <h1>{p.address}</h1>
        {price ? <div class="card-price" style="font-size:2rem;">{price}</div> : <div class="card-price tbd" style="font-size:1.2rem;">Contact for pricing</div>}

        {specs.length > 0 ? (
          <div class="spec-grid">
            {specs.map(([k, v]) => <div><div class="k">{k}</div><div class="v">{v}</div></div>)}
          </div>
        ) : (
          <div class="note-banner" style="margin:30px 0;text-align:left;">Full details for this property are being finalized. Contact us for bedrooms, baths, square footage, and pricing.</div>
        )}

        {p.description && <p>{p.description}</p>}

        {p.images.length > 1 && (
          <>
            <h3 style="margin-top:40px;">Gallery</h3>
            <div class="gallery">
              {p.images.map((img) => <img src={img.thumb} data-full={img.jpg} alt={p.address} class="lb" loading="lazy" />)}
            </div>
          </>
        )}
      </div>

      <aside>
        <div class="aside-card">
          <h3>Interested?</h3>
          <p>Request a private showing or more information about {p.address}.</p>
          <a href={`${base}/contact?property=${encodeURIComponent(p.address + ', ' + p.location)}`} class="btn" style="width:100%;text-align:center;">Request Info</a>
          <p style="margin-top:20px;font-size:.9rem;">Or email us directly at<br /><a href="mailto:info@giaccioproperties.com" style="color:var(--gold-soft);font-weight:600;">info@giaccioproperties.com</a></p>
        </div>
      </aside>
    </div>
    <p style="padding-bottom:60px;"><a href={`${base}/#listings`} style="color:var(--gold-soft);font-weight:600;">&larr; Back to all listings</a></p>
  </div>

  <div id="lightbox" class="lightbox">
    <img id="lbImg" alt="" />
  </div>
  <script>
    const lb = document.getElementById('lightbox');
    const lbImg = document.getElementById('lbImg');
    document.querySelectorAll('img.lb').forEach((im) => im.addEventListener('click', () => {
      lbImg.src = im.dataset.full; lb.style.display = 'flex';
    }));
    lb.addEventListener('click', () => { lb.style.display = 'none'; lbImg.src = ''; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { lb.style.display = 'none'; } });
  </script>
</BaseLayout>
