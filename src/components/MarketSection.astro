---
import market from '../../data/market.json';
const { months, series, source, note, updated } = market;
const fmtUpdated = (() => {
  const [y, m] = updated.split('-').map(Number);
  return new Date(y, m - 1, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
})();
---
<section class="section alt market" id="market" data-market={JSON.stringify({ months, series })}>
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Local Market</p>
      <h2>Westchester County Market</h2>
      <div class="gold-rule center"></div>
      <p>Monthly housing-market statistics for Westchester County, New York, drawn from public Federal Reserve data. Updated {fmtUpdated}.</p>
    </div>

    <div class="mkt-cards" id="mktCards" data-reveal></div>

    <div class="mkt-panel" data-reveal>
      <div class="mkt-head">
        <h3 id="mktTitle">Median Listing Price</h3>
        <div class="mkt-toggle" id="mktToggle" role="tablist">
          <button data-k="price" class="on" role="tab">Price</button>
          <button data-k="active" role="tab">Inventory</button>
          <button data-k="dom" role="tab">Days on Market</button>
        </div>
      </div>
      <p class="mkt-hint" id="mktHint"></p>
      <div id="mktChart"></div>
    </div>

    <p class="mkt-foot" data-reveal>
      <b>Source:</b> {source} {note}
    </p>
  </div>
</section>

<style>
  .market .section-head { text-align: center; max-width: 720px; margin: 0 auto 44px; }
  .mkt-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 22px; }
  .mkt-card { background: var(--bg-2); border: 1px solid var(--line); border-radius: 14px; padding: 20px 20px 18px; }
  .mkt-card .label { font-size: .78rem; color: var(--muted); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .mkt-card .value { font-family: var(--serif); font-size: 2rem; color: var(--ink); margin: 8px 0 4px; letter-spacing: .3px; }
  .chg { font-size: .8rem; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; }
  .chg.up { color: #7fb08a; } .chg.down { color: var(--error); }
  .chg .yoy { color: var(--muted); font-weight: 500; margin-left: 4px; }
  .mkt-panel { background: var(--bg-2); border: 1px solid var(--line); border-radius: 16px; padding: 24px 24px 12px; }
  .mkt-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 10px; margin-bottom: 4px; }
  .mkt-head h3 { font-size: 1.15rem; margin: 0; }
  .mkt-toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
  .mkt-toggle button { border: 0; background: transparent; color: var(--muted); font-family: var(--sans); font-size: .78rem; font-weight: 600; padding: 7px 15px; cursor: pointer; transition: .25s; }
  .mkt-toggle button.on { background: var(--gold); color: #14140f; }
  .mkt-hint { font-size: .78rem; color: var(--muted); margin: 0 0 6px; }
  .market svg { display: block; width: 100%; height: auto; }
  .market .axis { fill: var(--muted); font-size: 11px; font-family: var(--sans); }
  .market .grid { stroke: var(--line); stroke-width: 1; }
  .mkt-foot { font-size: .78rem; color: var(--muted); line-height: 1.7; margin-top: 20px; max-width: 760px; }
  .mkt-foot b { color: var(--body); }
  @media (max-width: 680px) { .mkt-cards { grid-template-columns: 1fr; } }
</style>

<script>
  const root = document.getElementById('market');
  if (root) {
    const { months, series } = JSON.parse(root.dataset.market);
    const fmt = {
      price: (v) => '$' + Math.round(v / 1000) + 'k',
      active: (v) => v.toLocaleString(),
      dom: (v) => v + ' days',
    };
    const pct = (cur, prev) => (cur - prev) / prev * 100;

    function chgHTML(k) {
      const s = series[k], d = s.data, cur = d[d.length - 1], yoy = d[d.length - 13];
      const diff = pct(cur, yoy);
      const good = s.goodDown ? diff < 0 : diff > 0;
      const arrow = diff >= 0 ? '▲' : '▼';
      return `<span class="chg ${good ? 'up' : 'down'}">${arrow} ${Math.abs(diff).toFixed(1)}%<span class="yoy">YoY</span></span>`;
    }
    function cardHTML(k) {
      const s = series[k], cur = s.data[s.data.length - 1];
      return `<div class="mkt-card"><div class="label">${s.title}</div><div class="value">${fmt[k](cur)}</div>${chgHTML(k)}</div>`;
    }
    document.getElementById('mktCards').innerHTML = ['price', 'active', 'dom'].map(cardHTML).join('');

    function draw(k) {
      const s = series[k], d = s.data;
      const W = 840, H = 280, padL = 58, padR = 16, padT = 16, padB = 34;
      const min = Math.min(...d), max = Math.max(...d);
      const lo = min - (max - min) * 0.12, hi = max + (max - min) * 0.12;
      const x = (i) => padL + (W - padL - padR) * (i / (d.length - 1));
      const y = (v) => padT + (H - padT - padB) * (1 - (v - lo) / (hi - lo));
      const line = d.map((v, i) => (i ? 'L' : 'M') + x(i).toFixed(1) + ',' + y(v).toFixed(1)).join(' ');
      const area = `M${x(0)},${y(d[0])} ` + d.map((v, i) => 'L' + x(i).toFixed(1) + ',' + y(v).toFixed(1)).join(' ') + ` L${x(d.length - 1)},${H - padB} L${x(0)},${H - padB} Z`;
      let grid = '';
      for (let t = 0; t <= 4; t++) {
        const v = lo + (hi - lo) * t / 4, yy = y(v);
        grid += `<line class="grid" x1="${padL}" y1="${yy.toFixed(1)}" x2="${W - padR}" y2="${yy.toFixed(1)}"/>`;
        grid += `<text class="axis" x="${padL - 8}" y="${(yy + 4).toFixed(1)}" text-anchor="end">${fmt[k](Math.round(v))}</text>`;
      }
      let xl = '';
      d.forEach((v, i) => {
        if (i % 4 === 0 || i === d.length - 1) {
          const lbl = months[i].slice(2).replace('-', '/');
          xl += `<text class="axis" x="${x(i).toFixed(1)}" y="${H - 12}" text-anchor="middle">${lbl}</text>`;
        }
      });
      const lastX = x(d.length - 1), lastY = y(d[d.length - 1]);
      document.getElementById('mktChart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="${s.title} over the last ${d.length} months">
        <defs><linearGradient id="mktG" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="var(--gold)" stop-opacity="0.22"/>
          <stop offset="1" stop-color="var(--gold)" stop-opacity="0"/></linearGradient></defs>
        ${grid}
        <path d="${area}" fill="url(#mktG)"/>
        <path d="${line}" fill="none" stroke="var(--gold)" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
        <circle cx="${lastX.toFixed(1)}" cy="${lastY.toFixed(1)}" r="4.5" fill="var(--gold)" stroke="var(--bg-2)" stroke-width="2"/>
        ${xl}
      </svg>`;
      document.getElementById('mktTitle').textContent = s.title;
      document.getElementById('mktHint').textContent = `Last ${d.length} months · ${months[0].replace('-', '/')} to ${months[months.length - 1].replace('-', '/')}`;
    }
    draw('price');
    document.getElementById('mktToggle').addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (!b) return;
      [...document.querySelectorAll('#mktToggle button')].forEach((x) => x.classList.remove('on'));
      b.classList.add('on');
      draw(b.dataset.k);
    });
  }
</script>
