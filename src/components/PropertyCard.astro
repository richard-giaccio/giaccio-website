---
import { formatPrice, statusLabel } from '../lib/properties.js';
const { p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const price = formatPrice(p.price);
const href = `${base}/properties/${p.slug}`;
---
<a class="card" href={href} data-town={p.town || ''} data-status={p.status || ''} data-beds={p.bedrooms ?? ''}>
  <div class="card-media">
    {p.status && <span class={`badge ${p.status}`}>{statusLabel(p.status)}</span>}
    {p.featured ? (
      <picture>
        <source srcset={p.featured.thumb} type="image/webp" />
        <img src={p.featured.jpg} alt={p.displayAddress} loading="lazy" decoding="async" />
      </picture>
    ) : (
      <div class="noimg">Photos coming soon</div>
    )}
  </div>
  <div class="card-body">
    <h3>{p.displayAddress}</h3>
    <div class="card-loc">{p.location}</div>
    {price ? <div class="card-price">{price}</div> : <div class="card-price tbd">Contact for details</div>}
    <div class="specs">
      {p.bedrooms != null && <span><strong>{p.bedrooms}</strong> Beds</span>}
      {p.bathrooms != null && <span><strong>{p.bathrooms}</strong> Baths</span>}
      {p.size_sqft != null && <span><strong>{Number(p.size_sqft).toLocaleString()}</strong> sq ft</span>}
      {p.bedrooms == null && p.bathrooms == null && p.size_sqft == null && (
        <span style="color:var(--muted);font-style:italic;">Details on request</span>
      )}
    </div>
    <div class="card-arrow">View Property &rarr;</div>
  </div>
</a>
